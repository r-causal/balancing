TARGET = @TARGET@

PROFILE = @PROFILE@
FEATURE_FLAGS = @FEATURE_FLAGS@

# Add flags if necessary
RUSTFLAGS =

TARGET_DIR = $(CURDIR)/rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/$(subst dev,debug,$(PROFILE))
STATLIB = $(LIBDIR)/libbalancing_savvy.a
PKG_LIBS = -L$(LIBDIR) -lbalancing_savvy

# Cargo home for the vendored build, created and used by this build alone. The
# recipe writes the crates-io redirect here and exports CARGO_HOME only in the
# branch that extracted the vendored archive. tools/config.toml records how cargo
# resolves the vendored directory that file names, which depends on this location.
CARGO_HOME_DIR = $(CURDIR)/rust/.cargo-vendor

CARGO_BUILD_ARGS = --lib -p balancing-savvy --profile $(PROFILE) $(FEATURE_FLAGS) --manifest-path=./rust/Cargo.toml --target-dir $(TARGET_DIR)

all: $(SHLIB) clean_intermediate

$(SHLIB): $(STATLIB)

# FORCE, because the recipe below has no way to say what it depends on. Its real
# prerequisites are every Rust source and manifest under ./rust and the resolved
# dependency graph, and cargo is what knows that set. Without a prerequisite make
# compares nothing and skips the recipe whenever the staticlib is already there,
# which links whatever wrote that file. clean_intermediate removes it after every
# successful link, so what this closes is the install interrupted between cargo
# writing the archive and that removal: the next install of any version finds the
# file, skips cargo, and links a staticlib built from sources it never saw.
# Re-running cargo costs one no-op invocation, since cargo is itself the cache and
# decides for itself what to rebuild.
$(STATLIB): FORCE
	# When the vendored source archive is present (CRAN releases), extract it and
	# redirect cargo to build offline against the vendored crates. Development and
	# CI builds have no archive and resolve dependencies from the registry.
	#
	# The redirect is the config file of a cargo home this build owns, and
	# CARGO_HOME is exported below only in the branch that extracted the archive.
	# A config file beside the sources would be read or ignored depending on where
	# the recipe ran cargo from, since cargo discovers .cargo/config.toml by
	# walking up from its working directory and never from the manifest that
	# --manifest-path names, and a redirect that is silently not read leaves cargo
	# resolving from crates.io. A cargo home is read wherever cargo is invoked
	# from. Nothing outside the build-owned directory is written, so the user's own
	# cargo home keeps its configuration, and no file left behind can redirect a
	# later build that has no vendored directory to be redirected to.
	#
	# The same condition passes --offline, which turns a redirect that failed to
	# apply into an error rather than a quiet download from crates.io.
	#
	# TAR is the archiver R chose for itself, and naming the codec keeps the
	# extraction from resting on the archiver detecting it.
	if [ -f ./rust/vendor.tar.xz ]; then \
	  "$(TAR)" --extract --xz --file=./rust/vendor.tar.xz --directory=./rust && \
	  mkdir -p "$(CARGO_HOME_DIR)" && \
	  cp ../tools/config.toml "$(CARGO_HOME_DIR)/config.toml"; \
	fi

	# In some environments, ~/.cargo/bin might not be included in PATH, so we need
	# to set it here to ensure cargo can be invoked. It is appended to PATH and
	# therefore is only used if cargo is absent from the user's PATH.
	export PATH="$(PATH):$(HOME)/.cargo/bin" && \
	  export CC="$(CC)" && \
	  export CFLAGS="$(CFLAGS)" && \
	  export RUSTFLAGS="$(RUSTFLAGS)" && \
	  export R_INCLUDE_DIR="$${R_INCLUDE_DIR:-$(R_HOME)/include}" && \
	  if [ -f ./rust/vendor.tar.xz ]; then \
	    export CARGO_HOME="$(CARGO_HOME_DIR)" && OFFLINE="--offline"; \
	  else \
	    OFFLINE=""; \
	  fi && \
	  @BEFORE_CARGO_BUILD@ \
	  if [ "$(TARGET)" != "wasm32-unknown-emscripten" ]; then \
	    cargo build -j 2 $(CARGO_BUILD_ARGS) $${OFFLINE}; \
	  else \
	    export CARGO_PROFILE_DEV_PANIC="abort" && \
	    export CARGO_PROFILE_RELEASE_PANIC="abort" && \
	    export RUSTFLAGS="$(RUSTFLAGS) -Zdefault-visibility=hidden" && \
	    cargo +nightly build -j 2 $(CARGO_BUILD_ARGS) --target $(TARGET) -Zbuild-std=panic_abort,std $${OFFLINE}; \
	  fi

clean_intermediate: $(SHLIB)
	rm -f $(STATLIB)
	# Remove the cargo build tree from the package sources once linking is
	# complete. Release installs, including R CMD check, must leave no build
	# artifacts behind: the subdirectory checks would otherwise flag the
	# version-control directories and generated files that cargo writes under
	# target. The build-owned cargo home goes with it, since nothing reads the
	# redirect once cargo has run. The development profile keeps both so repeated
	# load_all() and local rebuilds reuse the cached compilation.
	if [ "$(PROFILE)" != "dev" ]; then rm -Rf $(TARGET_DIR) $(CARGO_HOME_DIR); fi

clean:
	rm -Rf $(SHLIB) $(OBJECTS) $(STATLIB) ./rust/target ./rust/vendor ./rust/.cargo-vendor

# An empty rule with no prerequisites, which make therefore treats as out of date
# on every run, so that every target naming it is remade. .PHONY as well, so that
# a file of this name in the package could not make it up to date.
FORCE:

.PHONY: all clean_intermediate clean FORCE
