TARGET = @TARGET@

PROFILE = @PROFILE@
FEATURE_FLAGS = @FEATURE_FLAGS@

# Add flags if necessary
RUSTFLAGS =

TARGET_DIR = $(CURDIR)/rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/$(subst dev,debug,$(PROFILE))
STATLIB = $(LIBDIR)/libbalancing_savvy.a
PKG_LIBS = -L$(LIBDIR) -lbalancing_savvy

CARGO_BUILD_ARGS = --lib -p balancing-savvy --profile $(PROFILE) $(FEATURE_FLAGS) --manifest-path=./rust/Cargo.toml --target-dir $(TARGET_DIR)

all: $(SHLIB) clean_intermediate

$(SHLIB): $(STATLIB)

$(STATLIB):
	# When the vendored source archive is present (CRAN releases), extract it and
	# redirect cargo to build offline against the vendored crates. Development and
	# CI builds have no archive and resolve dependencies from the registry.
	#
	# The redirect is written to ./.cargo, not to ./rust/.cargo beside the workspace
	# manifest, because cargo looks for a config file by walking up from its working
	# directory and never from the manifest that --manifest-path names. make runs
	# this recipe in src, so a config file under ./rust is never read: the redirect
	# then silently does not apply, and cargo is left resolving from the registry
	# that --offline has just denied it. tools/config.toml names the vendored
	# directory relative to this directory for the same reason.
	#
	# The file is removed when no archive is present, so that its presence always
	# matches the archive's. It is build output rather than configuration, and a
	# redirect left behind by an earlier vendored build would otherwise be read by
	# every later build in the same tree, pointing at a vendored directory that
	# clean has since removed.
	if [ -f ./rust/vendor.tar.xz ]; then \
	  tar xf ./rust/vendor.tar.xz -C ./rust && \
	  mkdir -p ./.cargo && \
	  cp ../tools/config.toml ./.cargo/config.toml; \
	else \
	  rm -f ./.cargo/config.toml; \
	fi

	# In some environments, ~/.cargo/bin might not be included in PATH, so we need
	# to set it here to ensure cargo can be invoked. It is appended to PATH and
	# therefore is only used if cargo is absent from the user's PATH.
	export PATH="$(PATH):$(HOME)/.cargo/bin" && \
	  export CC="$(CC)" && \
	  export CFLAGS="$(CFLAGS)" && \
	  export RUSTFLAGS="$(RUSTFLAGS)" && \
	  export R_INCLUDE_DIR="$${R_INCLUDE_DIR:-$(R_HOME)/include}" && \
	  if [ -f ./rust/vendor.tar.xz ]; then OFFLINE="--offline"; else OFFLINE=""; fi && \
	  @BEFORE_CARGO_BUILD@ \
	  if [ "$(TARGET)" != "wasm32-unknown-emscripten" ]; then \
	    cargo build -j 2 $(CARGO_BUILD_ARGS) $${OFFLINE}; \
	  else \
	    export CARGO_PROFILE_DEV_PANIC="abort" && \
	    export CARGO_PROFILE_RELEASE_PANIC="abort" && \
	    export RUSTFLAGS="$(RUSTFLAGS) -Zdefault-visibility=hidden" && \
	    cargo +nightly build -j 2 $(CARGO_BUILD_ARGS) --target $(TARGET) -Zbuild-std=panic_abort,std; \
	  fi

clean_intermediate: $(SHLIB)
	rm -f $(STATLIB)
	# Remove the cargo build tree from the package sources once linking is
	# complete. Release installs, including R CMD check, must leave no build
	# artifacts behind: the subdirectory checks would otherwise flag the
	# version-control directories and generated files that cargo writes under
	# target. The development profile keeps the tree so repeated load_all() and
	# local rebuilds reuse the cached compilation.
	if [ "$(PROFILE)" != "dev" ]; then rm -Rf $(TARGET_DIR); fi

clean:
	rm -Rf $(SHLIB) $(OBJECTS) $(STATLIB) ./rust/target ./rust/vendor ./.cargo

.PHONY: all clean_intermediate clean
