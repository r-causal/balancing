TARGET = @TARGET@

PROFILE = @PROFILE@
FEATURE_FLAGS = @FEATURE_FLAGS@

# Add flags if necessary
RUSTFLAGS =

TARGET_DIR = $(CURDIR)/rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/$(subst dev,debug,$(PROFILE))
STATLIB = $(LIBDIR)/libbalancing_savvy.a
PKG_LIBS = -L$(LIBDIR) -lbalancing_savvy -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll

# Rtools doesn't have the linker in the location that cargo expects, so we need
# to overwrite it via configuration.
CARGO_LINKER = x86_64-w64-mingw32.static.posix-gcc.exe

CARGO_BUILD_ARGS = --target $(TARGET) --lib -p balancing-savvy --profile $(PROFILE) $(FEATURE_FLAGS) --manifest-path ./rust/Cargo.toml --target-dir $(TARGET_DIR)

all: $(SHLIB) clean_intermediate

$(SHLIB): $(STATLIB)

$(STATLIB):
	# When the GNU toolchain is used (i.e. on CRAN), -lgcc_eh is specified for
	# building proc-macro2, but Rtools doesn't contain libgcc_eh. This isn't used
	# in actual, but we need this tweak to please the compiler.
	mkdir -p $(LIBDIR)/libgcc_mock && touch $(LIBDIR)/libgcc_mock/libgcc_eh.a

	export CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER="$(CARGO_LINKER)" && \
	  export LIBRARY_PATH="$${LIBRARY_PATH};$(LIBDIR)/libgcc_mock" && \
	  export CC="$(CC)" && \
	  export CFLAGS="$(CFLAGS)" && \
	  export RUSTFLAGS="$(RUSTFLAGS)" && \
	  export R_INCLUDE_DIR="$${R_INCLUDE_DIR:-$(R_HOME)/include}" && \
	  cargo build -j 2 $(CARGO_BUILD_ARGS)

clean_intermediate: $(SHLIB)
	rm -f $(STATLIB)
	# Remove the cargo build tree from the package sources once linking is
	# complete. Release installs, including R CMD check, must leave no build
	# artifacts behind: the subdirectory checks would otherwise flag the
	# version-control directories and generated files that cargo writes under
	# target. The development profile keeps the tree so repeated load_all() and
	# local rebuilds reuse the cached compilation.
	if [ "$(PROFILE)" != "dev" ]; then rm -Rf $(TARGET_DIR); fi

clean:
	rm -Rf $(SHLIB) $(OBJECTS) $(STATLIB) ./rust/target

.PHONY: all clean_intermediate clean
